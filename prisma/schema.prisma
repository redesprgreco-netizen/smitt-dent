// prisma/schema.prisma
// Smitt-Dent — Schema para Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  admin
  doctora
  visitante
}

enum EstadoUsuario {
  pendiente
  activo
  inactivo
}

enum EstadoCita {
  pendiente
  confirmada
  cancelada
  completada
}

enum EstadoExpediente {
  activo
  inactivo
}

enum EstadoPieza {
  sin_tratamiento
  tratado
  pendiente
  extraccion
}

enum EstadoTratamiento {
  pendiente
  en_curso
  realizado
}

enum MetodoPago {
  efectivo
  transferencia
  tarjeta
}

enum EstadoPago {
  activo
  anulado
}

enum TipoMovimiento {
  entrada
  salida
}

enum EstadoSaludGeneral {
  bueno
  regular
  malo
}

enum Sexo {
  masculino
  femenino
  otro
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nombre       String        @db.VarChar(80)
  apellido     String        @db.VarChar(80)
  correo       String        @unique @db.VarChar(120)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  rol          Rol
  colorAgenda  String?       @map("color_agenda") @db.VarChar(7)
  estado       EstadoUsuario @default(pendiente)
  aprobadoPor  Int?          @map("aprobado_por")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relaciones
  aprobador            Usuario?             @relation("AprobacionUsuario", fields: [aprobadoPor], references: [id])
  aprobados            Usuario[]            @relation("AprobacionUsuario")
  citasAsignadas       Cita[]               @relation("CitaDoctora")
  citasCreadas         Cita[]               @relation("CitaCreador")
  expedientes          Expediente[]         @relation("ExpedienteDoctora")
  expedientesCreados   Expediente[]         @relation("ExpedienteCreador")
  historialCreado      HistorialClinico[]   @relation("HistorialCreador")
  odontogramaUpdates   OdontogramaPieza[]   @relation("OdontogramaUpdater")
  odontogramaHistorial OdontogramaHistorial[] @relation("OdontogramaChanger")
  planTratamiento      PlanTratamiento[]    @relation("PlanCreador")
  pagosRegistrados     Pago[]               @relation("PagoCreador")
  pagosAnulados        Pago[]               @relation("PagoAnulador")
  inventarioMovimientos InventarioMovimiento[] @relation("MovimientoCreador")
  bitacora             Bitacora[]           @relation("BitacoraUsuario")
  antecedentesActualizados AntecedentesPatologicos[] @relation("AntecedentesUpdater")
  consentimientosCreados   ConsentimientoInformado[] @relation("ConsentimientoCreador")

  @@map("usuarios")
}

model Cita {
  id               Int        @id @default(autoincrement())
  nombrePaciente   String     @map("nombre_paciente") @db.VarChar(80)
  apellidoPaciente String     @map("apellido_paciente") @db.VarChar(80)
  asunto           String     @db.VarChar(200)
  fecha            DateTime   @db.Date
  hora             DateTime   @db.Time()
  notas            String?    @db.Text
  doctoraId        Int        @map("doctora_id")
  expedienteId     Int?       @map("expediente_id")
  estado           EstadoCita @default(pendiente)
  createdBy        Int        @map("created_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  doctora    Usuario     @relation("CitaDoctora", fields: [doctoraId], references: [id])
  creador    Usuario     @relation("CitaCreador", fields: [createdBy], references: [id])
  expediente Expediente? @relation(fields: [expedienteId], references: [id])

  @@map("citas")
}

model Expediente {
  id            Int              @id @default(autoincrement())
  folio         String           @unique @db.VarChar(12)
  nombre        String           @db.VarChar(80)
  apellido      String           @db.VarChar(80)
  fechaNacimiento DateTime?      @map("fecha_nacimiento") @db.Date
  telefono      String?          @db.VarChar(20)
  correo        String?          @db.VarChar(120)
  alergias      String?          @db.Text
  motivoInicial String?          @map("motivo_inicial") @db.Text
  doctoraId     Int              @map("doctora_id")
  estado        EstadoExpediente @default(activo)
  createdBy     Int              @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // ── I. Ficha de identificación (campos adicionales) ──
  sexo                       Sexo?
  ocupacion                  String? @db.VarChar(120)
  domicilio                  String? @db.VarChar(200)
  ciudad                     String? @db.VarChar(80)
  codigoPostal               String? @map("codigo_postal") @db.VarChar(10)
  contactoEmergenciaNombre   String? @map("contacto_emergencia_nombre") @db.VarChar(120)
  contactoEmergenciaTelefono String? @map("contacto_emergencia_telefono") @db.VarChar(20)
  llenadoPorNombre           String? @map("llenado_por_nombre") @db.VarChar(120)
  llenadoPorParentesco       String? @map("llenado_por_parentesco") @db.VarChar(60)

  doctora         Usuario              @relation("ExpedienteDoctora", fields: [doctoraId], references: [id])
  creador         Usuario              @relation("ExpedienteCreador", fields: [createdBy], references: [id])
  citas           Cita[]
  historial       HistorialClinico[]
  odontograma     OdontogramaPieza[]
  odontogramaHist OdontogramaHistorial[]
  planTratamiento PlanTratamiento[]
  pagos           Pago[]
  antecedentes    AntecedentesPatologicos?
  consentimiento  ConsentimientoInformado?

  @@map("expedientes")
}

// ============================================================
// II. Antecedentes Patológicos Personales (cuestionario)
// ============================================================
model AntecedentesPatologicos {
  id           Int                 @id @default(autoincrement())
  expedienteId Int                 @unique @map("expediente_id")

  // 1. Estado de salud general
  estadoSalud  EstadoSaludGeneral? @map("estado_salud")

  // 2. Enfermedades personales (Sí/No)
  feReumatica        Boolean @default(false) @map("fe_reumatica")
  enfCardiovascular  Boolean @default(false) @map("enf_cardiovascular")
  mareosDesmayos     Boolean @default(false) @map("mareos_desmayos")
  diabetesPersonal   Boolean @default(false) @map("diabetes_personal")
  hepatitis          Boolean @default(false)
  vihSida            Boolean @default(false) @map("vih_sida")
  artritisReumatismo Boolean @default(false) @map("artritis_reumatismo")
  gastritisUlceras   Boolean @default(false) @map("gastritis_ulceras")
  problemasRenales   Boolean @default(false) @map("problemas_renales")
  anemia             Boolean @default(false)
  presionArterial    Boolean @default(false) @map("presion_arterial")
  sangradoAnormal    Boolean @default(false) @map("sangrado_anormal")
  moretonesFacil     Boolean @default(false) @map("moretones_facil")
  transfusiones      Boolean @default(false)
  asma               Boolean @default(false)

  // 3. Antecedentes familiares (Sí/No)
  diabetesFamiliar     Boolean @default(false) @map("diabetes_familiar")
  enfCorazonFamiliar   Boolean @default(false) @map("enf_corazon_familiar")
  hipertensionFamiliar Boolean @default(false) @map("hipertension_familiar")
  cancerFamiliar       Boolean @default(false) @map("cancer_familiar")

  // 4. Tratamiento médico actual
  tratamientoActual        Boolean @default(false) @map("tratamiento_actual")
  tratamientoActualDetalle String? @map("tratamiento_actual_detalle") @db.Text

  // 5. Alergia a anestésicos / medicamentos / látex
  alergicoAnestesico Boolean @default(false) @map("alergico_anestesico")
  alergicoDetalle    String? @map("alergico_detalle") @db.Text

  // 6-8. Otras preguntas de salud
  faltaAire      Boolean @default(false) @map("falta_aire")
  bocaSeca       Boolean @default(false) @map("boca_seca")
  embarazada     Boolean @default(false)
  mesesGestacion Int?    @map("meses_gestacion")

  // 9. Tabaquismo
  tabaquismo      Boolean @default(false)
  cigarrosDia     Int?    @map("cigarros_dia")
  tabaquismoAnios Int?    @map("tabaquismo_anios")

  // 10. Drogas
  drogas       Boolean @default(false)
  drogasCuales String? @map("drogas_cuales") @db.VarChar(200)
  drogasAnios  Int?    @map("drogas_anios")

  // 11. Alergias generales
  alergiasGenerales Boolean @default(false) @map("alergias_generales")
  alergiasCuales    String? @map("alergias_cuales") @db.VarChar(200)
  alergiasAnios     Int?    @map("alergias_anios")

  // 12. Alcoholismo
  alcoholismo       Boolean @default(false)
  alcoholCantSemana String? @map("alcohol_cant_semana") @db.VarChar(60)
  alcoholAnios      Int?    @map("alcohol_anios")

  updatedBy Int      @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expediente     Expediente @relation(fields: [expedienteId], references: [id])
  actualizadoPor Usuario    @relation("AntecedentesUpdater", fields: [updatedBy], references: [id])

  @@map("antecedentes_patologicos")
}

// ============================================================
// Consentimiento Informado
// ============================================================
model ConsentimientoInformado {
  id                       Int       @id @default(autoincrement())
  expedienteId             Int       @unique @map("expediente_id")
  nombreDentista           String?   @map("nombre_dentista") @db.VarChar(150)
  nombreRepresentanteLegal String?   @map("nombre_representante_legal") @db.VarChar(150)
  parentesco               String?   @db.VarChar(60)
  aceptado                 Boolean   @default(false)
  firmaNombre              String?   @map("firma_nombre") @db.VarChar(150)
  fechaFirma               DateTime? @map("fecha_firma") @db.Date
  createdBy                Int       @map("created_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  expediente Expediente @relation(fields: [expedienteId], references: [id])
  creador    Usuario    @relation("ConsentimientoCreador", fields: [createdBy], references: [id])

  @@map("consentimiento_informado")
}

model HistorialClinico {
  id             Int      @id @default(autoincrement())
  expedienteId   Int      @map("expediente_id")
  titulo         String   @db.VarChar(200)
  descripcion    String   @db.Text
  esCorreccion   Boolean  @default(false) @map("es_correccion")
  notaOriginalId Int?     @map("nota_original_id")
  createdBy      Int      @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  expediente   Expediente        @relation(fields: [expedienteId], references: [id])
  creador      Usuario           @relation("HistorialCreador", fields: [createdBy], references: [id])
  notaOriginal HistorialClinico? @relation("CorreccionNota", fields: [notaOriginalId], references: [id])
  correcciones HistorialClinico[] @relation("CorreccionNota")

  @@map("historial_clinico")
}

model OdontogramaPieza {
  id           Int         @id @default(autoincrement())
  expedienteId Int         @map("expediente_id")
  numeroPieza  Int         @map("numero_pieza") @db.SmallInt
  estado       EstadoPieza @default(sin_tratamiento)
  notas        String?     @db.Text
  updatedBy    Int         @map("updated_by")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  expediente Expediente @relation(fields: [expedienteId], references: [id])
  updater    Usuario    @relation("OdontogramaUpdater", fields: [updatedBy], references: [id])

  @@unique([expedienteId, numeroPieza])
  @@map("odontograma_piezas")
}

model OdontogramaHistorial {
  id             Int         @id @default(autoincrement())
  expedienteId   Int         @map("expediente_id")
  numeroPieza    Int         @map("numero_pieza") @db.SmallInt
  estadoAnterior EstadoPieza @map("estado_anterior")
  estadoNuevo    EstadoPieza @map("estado_nuevo")
  changedBy      Int         @map("changed_by")
  changedAt      DateTime    @default(now()) @map("changed_at")

  expediente Expediente @relation(fields: [expedienteId], references: [id])
  changer    Usuario    @relation("OdontogramaChanger", fields: [changedBy], references: [id])

  @@map("odontograma_historial")
}

model PlanTratamiento {
  id           Int               @id @default(autoincrement())
  expedienteId Int               @map("expediente_id")
  concepto     String            @db.VarChar(200)
  piezas       String?           @db.VarChar(100)
  cantidad     Decimal           @default(1) @db.Decimal(6, 2)
  precioUnitario Decimal         @map("precio_unitario") @db.Decimal(10, 2)
  subtotal     Decimal           @db.Decimal(10, 2)
  descuentoPct Decimal           @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  estado       EstadoTratamiento @default(pendiente)
  createdBy    Int               @map("created_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  expediente Expediente @relation(fields: [expedienteId], references: [id])
  creador    Usuario    @relation("PlanCreador", fields: [createdBy], references: [id])

  @@map("plan_tratamiento")
}

model Pago {
  id             Int        @id @default(autoincrement())
  folioRecibo    String     @unique @map("folio_recibo") @db.VarChar(15)
  expedienteId   Int        @map("expediente_id")
  monto          Decimal    @db.Decimal(10, 2)
  metodoPago     MetodoPago @map("metodo_pago")
  concepto       String?    @db.VarChar(200)
  estado         EstadoPago @default(activo)
  motivoAnulacion String?   @map("motivo_anulacion") @db.Text
  anuladoPor     Int?       @map("anulado_por")
  anuladoAt      DateTime?  @map("anulado_at")
  createdBy      Int        @map("created_by")
  createdAt      DateTime   @default(now()) @map("created_at")

  expediente Expediente @relation(fields: [expedienteId], references: [id])
  creador    Usuario    @relation("PagoCreador", fields: [createdBy], references: [id])
  anulador   Usuario?   @relation("PagoAnulador", fields: [anuladoPor], references: [id])

  @@map("pagos")
}

model InventarioArticulo {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(150)
  categoria    String?  @db.VarChar(80)
  unidadMedida String   @map("unidad_medida") @db.VarChar(30)
  stockActual  Decimal  @default(0) @map("stock_actual") @db.Decimal(8, 2)
  stockMinimo  Decimal  @default(0) @map("stock_minimo") @db.Decimal(8, 2)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  movimientos InventarioMovimiento[]

  @@map("inventario_articulos")
}

model InventarioMovimiento {
  id         Int            @id @default(autoincrement())
  articuloId Int            @map("articulo_id")
  tipo       TipoMovimiento
  cantidad   Decimal        @db.Decimal(8, 2)
  notas      String?        @db.Text
  createdBy  Int            @map("created_by")
  createdAt  DateTime       @default(now()) @map("created_at")

  articulo InventarioArticulo @relation(fields: [articuloId], references: [id])
  creador  Usuario            @relation("MovimientoCreador", fields: [createdBy], references: [id])

  @@map("inventario_movimientos")
}

model Bitacora {
  id             BigInt   @id @default(autoincrement())
  usuarioId      Int?     @map("usuario_id")
  accion         String   @db.VarChar(80)
  tablaAfectada  String   @map("tabla_afectada") @db.VarChar(60)
  registroId     Int?     @map("registro_id")
  valorAnterior  Json?    @map("valor_anterior")
  valorNuevo     Json?    @map("valor_nuevo")
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at")

  usuario Usuario? @relation("BitacoraUsuario", fields: [usuarioId], references: [id])

  @@map("bitacora")
}
